# ==============================================================================
# ROHILLA ADVERTISING CRM — FRONTEND PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# In production, set this to your Render Spring Boot backend URL.
# The client automatically ensures '/api/v1' is targeted.
#
# Examples:
#   VITE_API_BASE_URL=https://rohilla-crm-backend.onrender.com/api/v1
#   (or simply: https://rohilla-crm-backend.onrender.com)
#
# For local development with Vite dev-server proxy, you may leave this blank.
# ==============================================================================
VITE_API_BASE_URL=https://rohilla-crm-backend.onrender.com/api/v1
