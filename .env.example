# ==============================================================================
# ROHILLA ADVERTISING CRM — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# This template documents all production environment variables required for:
# 1. Render Web Service (Spring Boot Backend)
# 2. Render PostgreSQL (Managed Database)
# 3. Hostinger (React SPA Frontend)
#
# IMPORTANT:
# - NEVER commit real credentials or .env files to GitHub.
# - Configure these environment variables directly in the Render Dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER BACKEND RUNTIME
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
# Render dynamically assigns the PORT variable (default: 10000 or 8080)
PORT=8080

# ------------------------------------------------------------------------------
# 2. RENDER POSTGRESQL DATABASE CONNECTION
# ------------------------------------------------------------------------------
# In Render, when you create a PostgreSQL instance, use the "Internal Database URL"
# for highest speed and zero bandwidth costs between backend and DB:
# Format: postgresql://username:password@dpg-xxxxxx-a:5432/database_name
DATABASE_URL=postgresql://rohilla_user:replace_with_render_db_password@dpg-xxxxxx-a:5432/rohilla_crm

# Optional: You can also specify standard JDBC variables individually:
# SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-xxxxxx-a:5432/rohilla_crm?sslmode=require
# SPRING_DATASOURCE_USERNAME=rohilla_user
# SPRING_DATASOURCE_PASSWORD=replace_with_render_db_password

# HikariCP Connection Pool Settings
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5

# ------------------------------------------------------------------------------
# 3. SECURITY & JWT SECRETS (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Generate 64-byte hex strings using: openssl rand -hex 64
JWT_SECRET=replace_with_64_byte_hex_secret_key_for_access_tokens
REFRESH_TOKEN_SECRET=replace_with_64_byte_hex_secret_key_for_refresh_tokens

# Allowed CORS Origins (Your Hostinger domain, HTTPS only, comma-separated, no trailing slash)
# Example: https://crm.yourdomain.com,https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://crm.yourdomain.com

# ------------------------------------------------------------------------------
# 4. PERSISTENT FILE STORAGE (EMPLOYEE DOCUMENTS & DESIGN FILES)
# ------------------------------------------------------------------------------
# In Render Web Service settings, add a "Persistent Disk" mounted at /var/rohilla/storage:
STORAGE_BASE_PATH=/var/rohilla/storage

# ------------------------------------------------------------------------------
# 5. INITIAL OWNER / ADMIN BOOTSTRAP (RUNS ONCE ON FIRST STARTUP)
# ------------------------------------------------------------------------------
INITIAL_OWNER_EMAIL=owner@rohilla.com
INITIAL_OWNER_NAME=Aditye Rohilla
INITIAL_OWNER_PHONE=+91-9811000000
# If left blank, a cryptographically secure temporary password will be generated
# and displayed once in the Render deployment logs.
INITIAL_OWNER_PASSWORD=replace_with_secure_initial_owner_password

# ------------------------------------------------------------------------------
# 6. HOSTINGER FRONTEND BUILD VARIABLE (Set locally before 'npm run build')
# ------------------------------------------------------------------------------
# Points the React frontend to your Render backend service:
VITE_API_BASE_URL=https://rohilla-crm-backend.onrender.com/api/v1
