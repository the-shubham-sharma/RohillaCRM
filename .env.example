# ==============================================================================
# ROHILLA ADVERTISING CRM — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' on your Hostinger VPS deployment server:
#    cp .env.example .env
# 2. Fill in the production values below.
# 3. Ensure '.env' permissions are restricted (chmod 600 .env).
# 4. NEVER commit the actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# ------------------------------------------------------------------------------
# POSTGRESQL PRODUCTION DATABASE
# ------------------------------------------------------------------------------
POSTGRES_DB=rohilla_crm
POSTGRES_USER=rohilla_db_user
POSTGRES_PASSWORD=replace_with_strong_pg_password_here

# Backend Connection String (within Docker network 'postgres' is the container host)
DATABASE_URL=jdbc:postgresql://postgres:5432/rohilla_crm
DATABASE_USERNAME=rohilla_db_user
DATABASE_PASSWORD=replace_with_strong_pg_password_here

# Connection Pool Settings
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5

# ------------------------------------------------------------------------------
# JWT & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_64_byte_hex_secret_key_for_access_tokens
REFRESH_TOKEN_SECRET=replace_with_64_byte_hex_secret_key_for_refresh_tokens

# Allowed CORS Origins (Comma-separated, no trailing slash, must use HTTPS in production)
CORS_ALLOWED_ORIGINS=https://crm.yourdomain.com

# ------------------------------------------------------------------------------
# SECURE PRIVATE OBJECT/FILE STORAGE
# ------------------------------------------------------------------------------
# Path inside the backend Docker container (mounted via persistent volume)
STORAGE_BASE_PATH=/var/rohilla/storage

# Host directory for persistent file storage on VPS
HOST_STORAGE_PATH=/opt/rohilla-crm/storage

# ------------------------------------------------------------------------------
# INITIAL OWNER ACCOUNT SETUP (RUNS ONCE ON FIRST PRODUCTION STARTUP)
# ------------------------------------------------------------------------------
INITIAL_OWNER_EMAIL=owner@rohilla.com
INITIAL_OWNER_NAME=Aditye Rohilla
INITIAL_OWNER_PHONE=+91-9811000000
# Optional: If left blank, a cryptographically secure random password will be
# generated and printed once to the console log on first startup.
INITIAL_OWNER_PASSWORD=

# ------------------------------------------------------------------------------
# SMTP / EMAIL NOTIFICATION CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=notifications@rohilla.com
MAIL_PASSWORD=replace_with_smtp_password
